DATABASE_URL=postgres://usuario:postgres@host:5432/nombre_bd?sslmode=require
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=correo-remitente@gmail.com
SMTP_PASS=contraseña-de-aplicacion-de-gmail
SMTP_FROM_NAME=SST
# Correo de una persona real para responder (ayuda a que no caiga en spam). Opcional.
SMTP_REPLY_TO=
# Puerto donde escucha el servidor (npm start)
PORT=3000
# Solo "true" si el sistema se sirve con https://. En http:// (red interna) déjalo en false.
COOKIE_SECURE=false
# Prefijo cuando corre como sub-aplicación de IIS (http://servidor/libreta/). Vacío si va en la raíz.
BASE_PATH=
# 127.0.0.1 detrás de IIS, para que solo IIS llegue al proceso. Vacío = todas las interfaces.
HOST=
