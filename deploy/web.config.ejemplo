<?xml version="1.0" encoding="utf-8"?>
<!--
  Copiar a la raíz del proyecto EN EL SERVIDOR como web.config y reemplazar
  D:\Aplicaciones\wwwroot\libreta por la ruta real (4 apariciones).
  El alias de la sub-aplicación en IIS debe coincidir con BASE_PATH del .env (p. ej. /libreta).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="NodeHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform
        processPath="C:\Program Files\nodejs\node.exe"
        arguments="--env-file=D:\Aplicaciones\wwwroot\libreta\.env D:\Aplicaciones\wwwroot\libreta\scripts\dev-server.js"
        stdoutLogEnabled="true"
        stdoutLogFile="D:\Aplicaciones\wwwroot\libreta\logs\node.log"
        startupTimeLimit="60"
        processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOST" value="127.0.0.1" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <!-- Las fotos de evidencia viajan en el cuerpo de la petición (hasta 30 MB). -->
        <requestLimits maxAllowedContentLength="31457280" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
